---
import PicoLogo from './PicoLogo.astro';
import { ArrowRight, Github, Shield } from 'lucide-astro';
---

<!-- Left Section: Branding & Features -->
<div class="flex-1 flex flex-col items-start justify-center space-y-8 w-full">
    
    <!-- Branding -->
    <div class="flex flex-col items-start">
        <div class="mb-6">
           <PicoLogo />
        </div>
        <p class="text-xl text-muted-foreground max-w-lg leading-relaxed font-sans mt-2">
            A compact DNS-based ad blocker for the Seeed XIAO ESP32-C6. Place it on your network edge to filter ads and tracking domains at the DNS level — no client-side software needed.
        </p>
    </div>

    <!-- Actions -->
    <div class="flex flex-row gap-4 w-full max-w-md">
        <a href="https://github.com/CierCier/adblock32" target="_blank" rel="noopener noreferrer" class="group flex-1 flex items-center justify-center gap-2 bg-secondary hover:bg-secondary/90 text-secondary-foreground px-6 py-3 rounded-lg font-bold text-sm tracking-wide transition-all shadow-[0_0_20px_-5px_rgba(195,251,91,0.3)] hover:shadow-[0_0_30px_-5px_rgba(195,251,91,0.5)] transform hover:-translate-y-0.5">
            <span>BUILD YOUR OWN</span>
            <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
        </a>
        <a href="https://github.com/CierCier/adblock32" target="_blank" rel="noopener noreferrer" class="flex-1 flex items-center justify-center gap-2 bg-transparent hover:bg-muted text-foreground border border-border px-6 py-3 rounded-lg font-medium text-sm tracking-wide transition-colors">
            <Github class="w-4 h-4" />
            <span>SOURCE</span>
        </a>
    </div>

    <!-- Serial Terminal Feature Highlight -->
    <div class="w-full max-w-md pt-6 border-t border-border/30">
        <div class="relative flex items-center gap-4 p-4 rounded-lg bg-card/30 border border-border/50 group cursor-help transition-colors hover:bg-card/50 hover:border-primary/30">
            <div class="p-2.5 rounded bg-primary/10 text-primary">
                <Shield class="w-6 h-6" />
            </div>
            <div>
                <h3 class="text-sm font-bold font-mono text-foreground uppercase tracking-wider mb-1">Network-Level Blocking</h3>
                <p class="text-xs text-muted-foreground">Point your router's DNS at the ESP32-C6 and block ads across every device on your LAN — no installs needed.</p>
            </div>
            
            <!-- Hover Card: Screenshot -->
            <div class="absolute left-1/2 -translate-x-1/2 bottom-full mb-4 w-[300px] opacity-0 translate-y-2 pointer-events-none transition-all duration-300 group-hover:opacity-100 group-hover:translate-y-0 z-50">
                <img src="/ss.png" alt="Interface Screenshot" class="w-full h-auto rounded-lg shadow-2xl" />
            </div>
        </div>
    </div>
</div>
